// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output   = "../src/generated/prisma"
    binaryTargets = ["native", "rhel-openssl-3.0.x"]

}

generator client_standard {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}


datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


// ==========================================
// 👤 USER MANAGEMENT & AUTHENTICATION
// ==========================================
model User {
  id        String   @id @default(uuid())
  status    UserStatus   @default(ACTIVE)
  email     String   @unique
  username  String   @unique
  password  String   // Hashed password
  affiliate_link String? @unique @default(uuid())
  referrer String?
  referral_sent Boolean @default(false)
  balance   Decimal  @default(0.00) @db.Decimal(10, 2) // Available wallet balance
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  bets      Bet[]    // One-to-many: One user can place multiple bets
  transfers moneyTransfers[] // One-to-many: Money transfer requests
}

model Admin{
  id String @id @default(uuid())
  name String
  email String @unique
  username String @unique
  password String
  password2 String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id        String      @id @default(cuid())
  key       String      @unique
  type      SettingType @default(STRING)
  value     Json
  label     String?
  group     String?     // e.g. "appearance", "general", "counters"
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  COLOR
  JSON

}


enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ==========================================
// ⚽ WORLD CUP FIXTURES & MATCHES
// ==========================================
model Match {
  id                  String      @id @default(uuid())
  apiMatchId          Int         @unique // Numeric hash of the Odds API event ID
  apiEventId          String? // Original Odds API event ID string
  homeTeam            String
  awayTeam            String
  kickoffTime         DateTime
  stage               String   
  addToBetting Boolean @default(false)

  status              MatchStatus @default(UPCOMING)
  winner              GameResult @default(NOTDECIDED)
  homeScore           Int?        // Full-time home goals
  awayScore           Int?        // Full-time away goals
  homeScoreH1         Int?        // Half-time home goals
  awayScoreH1         Int?        // Half-time away goals
  homeScoreH2         Int?        // Second-half home goals
  awayScoreH2         Int?        // Second-half away goals
  settled             Boolean     @default(false)  // Whether bets have been settled for this match
  gameOddsTable       GameOddsTable?
  // Automation flags for your 10-minute cron check
  preMatchSynced      Boolean     @default(false)
  postMatchSettled    Boolean     @default(false)
  
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
addedtoBetting  Boolean     @default(false)
  markets             Market[]    // One-to-many: One match has multiple betting markets
  marketOdds          MarketOdds[] // Polymorphic odds for all market types (up to 20)
  bets                Bet[]
  betSelections       BetSelection[]


  h2hRecords h2h_records[]
  totalsRecords totals_records[]
  bttsRecords btts_records[]
  doubleChanceRecords double_chance_records[]
  noBetRecords no_bet_records[]
  spreadRecords spread_records[]
}

enum GameResult {
  NOTDECIDED
  HOMEWIN
  AWAYWIN
  DRAW
  CANCELLED
  POSTPONED
  NOTPLAYED
}

model GameOddsTable {
  id            Int       @id @default(autoincrement())
  matchId       String    @unique
  match         Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)


  homeTeamOdds  Float?
  awayTeamOdds  Float?
  drawOdds      Float?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ==========================================
// 📊 EXPANDED MARKET ODDS (Up to 20 Markets)
// ==========================================
// Generic polymorphic market-odds store for all market types from The Odds API.
// Replaces the old static h2h-only approach with a flexible key-value structure
// that can represent any market (totals, spreads, BTTS, player props, etc.).
// ==========================================
model MarketOdds {
  id            String   @id @default(uuid())
  gameId        String
  marketKey     String   // e.g., 'h2h', 'btts', 'totals', 'spreads', 'h2h_h1', 'totals_home', 'player_anytime_td'
  outcomeName   String   // e.g., 'Home', 'Away', 'Draw', 'Yes', 'No', 'Over', 'Under', 'Lionel Messi'
  point         Decimal? @db.Decimal(5, 2) // vital for totals (2.5) and spreads (-1.5); null for h2h/btts
  odds          Decimal  @db.Decimal(10, 2)
  bookmakerKey  String   @default("pinnacle") // e.g., 'pinnacle', 'bet365', 'williamhill'
  updatedAt     DateTime @updatedAt @map("updated_at")

  match         Match    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([gameId, marketKey])
  @@map("market_odds")
}

enum MatchStatus {
  UPCOMING
  LIVE
  FINISHED
  CANCELLED
}

// ==========================================
// 📊 BETTING MARKETS & ODDS
// ==========================================
model Market {
  id        String    @id @default(uuid())
  matchId   String
  name      String    // e.g., "1X2", "Double Chance", "Over/Under 2.5"
  isLocked  Boolean   @default(false) // Admin can lock a market instantly
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  outcomes  Outcome[] // One-to-many: e.g., "1X2" market has 3 outcomes (Home, Draw, Away)

  @@index([matchId])
}


model h2h_records{
  id String @id @default(uuid())
  type_name String?
  matchId String
  match Match @relation(fields: [matchId], references: [id])
  home_wins Decimal @db.Decimal(10, 2)
  away_wins Decimal @db.Decimal(10, 2)
  draw Decimal @db.Decimal(10, 2)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}
model totals_records{
  id String @id @default(uuid())
  type_name String?
  matchId String
  match Match @relation(fields: [matchId], references: [id])
  over Decimal? @db.Decimal(10, 2)
  under Decimal? @db.Decimal(10, 2)
  point Decimal @db.Decimal(10, 2)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model btts_records{
  id String @id @default(uuid())
  type_name String?
  matchId String
  match Match @relation(fields: [matchId], references: [id])
  yes Decimal @db.Decimal(10, 2)
  no Decimal @db.Decimal(10, 2)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model double_chance_records{
  id String @id @default(uuid())
  type_name String?
  matchId String
  match Match @relation(fields: [matchId], references: [id])
  home_draw Decimal @db.Decimal(10, 2)
  away_draw Decimal @db.Decimal(10, 2)
  home_away Decimal @db.Decimal(10, 2)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model no_bet_records{
id String @id @default(uuid())
type_name String?
matchId String
match Match @relation(fields: [matchId], references: [id])

home Decimal @db.Decimal(10,2)
away Decimal @db.Decimal(10,2)

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}

model spread_records{
id String @id @default(uuid())
matchId String
type_name String?
match Match @relation(fields: [matchId], references: [id])
teams String
team Decimal @db.Decimal(10,2)
points Decimal @db.Decimal(10,2)

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}

  




model Outcome {
  id             String         @id @default(uuid())
  marketId       String
  name           String         // e.g., "Home", "Draw", "Away", "1X", "X2"
  odds           Decimal        @db.Decimal(5, 2) // Current shifting odds (e.g., 2.15)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  market         Market         @relation(fields: [marketId], references: [id], onDelete: Cascade)
  betSelections  BetSelection[] // Keeps track of slips that selected this outcome

  @@index([marketId])
}

// ==========================================
// 🎫 USER SLIPS & BET SELECTIONS
// ==========================================
model Bet {
  id              String         @id @default(uuid())
  userId          String
  matchId         String?        // null for parlays
  typeofBet       TypeofBet?     // null for parlays
  stake           Decimal        @db.Decimal(10, 2)
  potentialPayout Decimal        @db.Decimal(10, 2)
  cumulativeOdds  Decimal?       @db.Decimal(10, 2) // product of all selection odds (parlays)
  status          BetStatus      @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  match           Match?         @relation(fields: [matchId], references: [id])
  selections      BetSelection[]

  @@index([userId])
  @@index([matchId])
}

enum BetStatus {
  PENDING
  WON
  LOST
  VOIDED
}

model BettingTypes{
  id String @id @default(uuid())
  name String
  typeofBet TypeofBet
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([typeofBet])
}

model TypesOfMarkets {
  id        String   @id @default(uuid())
  name      String
  shortName String   @unique
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TypeofBet {
  // Core h2h
  HOME_WINS
  AWAY_WINS
  DRAW

  // Double chance / draw no bet
  HOME_WINS_OR_DRAW
  AWAY_WINS_OR_DRAW
  HOME_OR_AWAY

  // Both teams to score
  BOTH_TEAMS_TO_SCORE_YES
  BOTH_TEAMS_TO_SCORE_NO

  // Totals / Over-Under
  OVER
  UNDER

  // Spreads / Handicaps
  HOME_COVER
  AWAY_COVER

  // Half-time markets (H1)
  HT_HOME_WINS
  HT_AWAY_WINS
  HT_DRAW

  // Second-half markets (H2)
  HT2_HOME_WINS
  HT2_AWAY_WINS
  HT2_DRAW

  // Player props (generic — actual player name stored in BetSelection.outcomeName)
  ANYTIME_GOALSCORER
  FIRST_GOALSCORER
  LAST_GOALSCORER
}

// This join table saves the EXACT odds at the moment the user placed the bet
model BetSelection {
  id          String          @id @default(uuid())
  betId       String
  matchId     String
  marketKey   String          @default("h2h") // Which market this leg belongs to ("h2h", "btts", "totals", etc.)
  typeofBet   TypeofBet
  point       Decimal?        @db.Decimal(5, 2) // Locked-in point for totals/spreads (e.g., 2.5, -1.5)
  outcomeName String?         // Human-readable outcome label (e.g., "Lionel Messi" for player props)
  oddsAtBet   Decimal         @db.Decimal(5, 2) // Locked-in odds for the user
  status      SelectionStatus @default(PENDING) // Individual leg status
  outcomeId   String?

  bet         Bet             @relation(fields: [betId], references: [id], onDelete: Cascade)
  match       Match           @relation(fields: [matchId], references: [id])
  outcome     Outcome?        @relation(fields: [outcomeId], references: [id])

  @@index([betId])
  @@index([matchId])
  @@index([outcomeId])
}

enum SelectionStatus {
  PENDING
  WON
  LOST
  VOIDED
}


model moneyTransfers {
  id String @id @default(uuid())
  userId String
  amount Decimal @db.Decimal(10, 2)
  type TransferType @default(TELE_BIRR)
  status TransferStatus @default(PENDING)
  transactionId String?
  name String?
  phone String?
  reason String?
  img String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransferType {
TELE_BIRR
CBE
AWASH_BANK
ABYSSINIA_BANK
DASHEN_BANK
M_PESA
}